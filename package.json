{
  "name": "@motion-script/root",
  "private": true,
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=\"!@motion-script/site\" --force",
    "version-packages": "changeset version && node scripts/sync-root-version.js && pnpm install --no-frozen-lockfile",
    "release": "pnpm build:lib && changeset publish",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @motion-script/e2e run test:e2e",
    "e2e:stable": "node scripts/pack-stable.js",
    "e2e:stable:from-tarballs": "node scripts/pack-stable.js --from-tarballs",
    "e2e:shoot:lib": "pnpm --filter @motion-script/e2e run screenshot -- --variant lib",
    "e2e:shoot:stable": "pnpm --filter @motion-script/e2e run screenshot -- --variant stable",
    "e2e:compare": "pnpm --filter @motion-script/e2e run compare",
    "e2e:ci": "node scripts/pack-stable.js --no-build && pnpm --filter @motion-script/e2e run test:e2e",
    "clean": "turbo run clean && rimraf .turbo && rimraf --glob \"packages/**/node_modules/.vite-motion-script\""
  },
  "author": "Motion Script",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.9",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "concurrently": "^9.0.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.14"
  }
}