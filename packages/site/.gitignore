# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Standalone player app bundle embedded by /editor — generated by
# `pnpm --filter @motion-script/player build:app`. A build artifact, not source.
/public/player

# Generated API reference — typedoc markdown emitted by `pnpm build:api`
# (scripts/build-api.mjs) from the packages' source. A build artifact.
/content/api

# Docs search index — generated by `pnpm build:search` (lib/build-search-index.ts).
/public/search-index.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts
