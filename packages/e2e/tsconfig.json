{
  "compilerOptions": {
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "jsxImportSource": "motion-script",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts"
  ]
}
