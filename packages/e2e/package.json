{
  "name": "@motion-script/e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Visual end-to-end test harness: renders one scene per TESTS.md checkbox at 960x540/30fps, screenshots first/mid/last frames, and pixel-diffs a stable build against the live library build.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "tsx scripts/gen-scenes.ts",
    "list": "ms list",
    "screenshot": "tsx scripts/shoot.ts",
    "compare": "tsx scripts/compare.ts",
    "test:e2e": "tsx scripts/run.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rimraf out .turbo",
    "clear-stable": "rimraf out stable"
  },
  "dependencies": {
    "motion-script": "workspace:*"
  },
  "devDependencies": {
    "@motion-script/cli": "workspace:*",
    "@motion-script/vite-plugin": "workspace:*",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}