{
  "name": "@motion-script/skia-render",
  "version": "2.15.0",
  "type": "module",
  "description": "Backend-agnostic Skia/CanvasKit renderer for Motion Script. Holds the shape, fill, stroke, effect, text and 3D logic; platform specifics (surface creation, media decode, encoding, audio) are injected.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motion-script/motion-script.git",
    "directory": "packages/skia-render"
  },
  "sideEffects": false,
  "keywords": [],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "eslint . && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "dev": "concurrently \"tsc -p tsconfig.build.json --watch\" \"tsc-alias -p tsconfig.build.json -w\"",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@motion-script/canvaskit": "workspace:^",
    "@motion-script/core": "workspace:^"
  },
  "devDependencies": {
    "@motion-script/canvaskit": "workspace:*",
    "@motion-script/core": "workspace:*",
    "@types/three": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "dependencies": {
    "three": "catalog:"
  }
}
