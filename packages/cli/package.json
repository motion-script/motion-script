{
  "name": "@motion-script/cli",
  "version": "2.15.0",
  "description": "Headless command-line renderer for Motion Script projects (ms list / ms screenshot / ms export).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motion-script/motion-script.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ms": "dist/cli.js",
    "motion-script": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project": {
      "types": "./project.d.ts"
    }
  },
  "files": [
    "dist",
    "harness",
    "project.d.ts",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p harness/tsconfig.json"
  },
  "dependencies": {
    "@motion-script/canvaskit": "workspace:*",
    "@motion-script/core": "workspace:*",
    "@motion-script/web": "workspace:*",
    "acorn": "^8.17.0",
    "cli-progress": "^3.12.0",
    "estree-walker": "^3.0.3",
    "fontkit": "^2.0.4",
    "image-size": "^2.0.2",
    "kleur": "^4.1.5",
    "minimist": "^1.2.8",
    "music-metadata": "^11.8.3",
    "playwright": "^1.50.0"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/estree": "^1.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
